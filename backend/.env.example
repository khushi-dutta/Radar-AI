# All values have working defaults; copy to .env only to override.

PORT=4000

# Required in production — the server refuses to boot with the dev default.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me

# SQLite file location. The directory is created if missing.
DB_PATH=./data/radar.db

# Allowed browser origin. Defaults to reflecting the request origin in dev.
CORS_ORIGIN=http://localhost:5173
